# EcoVolt Backend Environment Variables
# Copy this file to .env for local development

# Environment
ENVIRONMENT=dev

# Database Configuration (injected by Terraform in Lambda)
DB_HOST=localhost
DB_NAME=ecovolt
DB_USER=ecovolt_admin
DB_PASS=your_password_here

# Cognito Configuration
COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# DynamoDB Tables
DYNAMODB_BATTERIES_TABLE=dev-batteries
DYNAMODB_TELEMETRY_TABLE=dev-bike-telemetry
DYNAMODB_NOTIFICATIONS_TABLE=dev-notifications

# SNS
SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:xxxxxxxxxxxx:dev-notifications

# IoT
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.eu-central-1.amazonaws.com

# Logging
LOG_LEVEL=INFO

# Note: In Lambda, these values are injected by Terraform at deploy time
# For local development, set these values manually
